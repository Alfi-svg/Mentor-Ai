# ==============================================================================
# Mentor AI — Production Backend Configuration (.env.production.example)
# NEVER commit the filled version of this file (.env.production) to source control.
# In cloud hosts (Render, Koyeb, Fly.io), set these in the dashboard Environment Variables.
# ==============================================================================

# Server Environment
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & CORS
# Set to your exact Vercel frontend production domain(s)
ALLOWED_ORIGINS=https://mentor-ai.vercel.app,https://mentor-ai-web.vercel.app
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-at-least-32-chars-random-hex-string

# Supabase (PostgreSQL & GoTrue Auth)
# Obtain from Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
# Connection pooler URL (Transaction mode on port 6543, or direct 5432):
DATABASE_URL=postgresql+asyncpg://postgres.<your-project-ref>:<your-db-password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?ssl=require

# AI Provider Configuration (Google AI Studio Free Tier / Groq / Fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=<your-google-ai-studio-gemini-key>
GEMINI_MODEL=gemini-2.0-flash
AI_ALLOW_OFFLINE_FALLBACK=true
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=12.0

# Optional Secondary Provider: Groq Cloud
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Calendar Integration & OAuth (Google Cloud Console in Testing Mode)
CALENDAR_PROVIDER=google_calendar
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
GOOGLE_REDIRECT_URI=https://<your-backend-domain>.onrender.com/api/v1/calendar/callback
# AES-128 Fernet key generated with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_ENCRYPTION_KEY=<generated-fernet-key-32-urlsafe-bytes>
CALENDAR_REQUEST_TIMEOUT_SECONDS=10.0

# MCP Server
MCP_TRANSPORT=stdio
