# ==============================================================================
# Mentor AI — Backend Configuration (.env.example)
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & CORS (comma-separated list of permitted frontend origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars

# Supabase Auth & Database (Placeholders for Day 3)
SUPABASE_URL=https://placeholder-project-id.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:placeholder-password@placeholder-project-id.supabase.co:5432/postgres

# AI Provider Configuration (Default offline for deterministic tests)
# Options: offline | gemini | groq
AI_PROVIDER=offline
GEMINI_API_KEY=AQ.Ab8RN6I7BasmR1DoQmddzBH61q7k4Z7xCeg3WXi_GghgQPQzCw
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT_SECONDS=12.0
AI_MAX_RETRIES=2
AI_ALLOW_OFFLINE_FALLBACK=true
 
# Google Calendar Integration & OAuth (Placeholders for Day 8)
CALENDAR_PROVIDER=google_calendar
GOOGLE_CLIENT_ID=886274283264-vin66me77ec88jfqhd0sf5nqii52io32.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
CALENDAR_ENCRYPTION_KEY=
CALENDAR_REQUEST_TIMEOUT_SECONDS=10.0
