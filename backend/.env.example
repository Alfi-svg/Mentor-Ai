# ==============================================================================
# Mentor AI — Backend Configuration (.env.example)
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & CORS (comma-separated list of permitted frontend origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars

# Supabase Auth & Database
SUPABASE_URL=https://placeholder-project-id.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:placeholder-password@placeholder-project-id.supabase.co:5432/postgres

# OpenAI Intelligence Layer & Voice Copilot (Phase 9)
OPENAI_API_KEY=sk-placeholder-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_STT_MODEL=whisper-1
OPENAI_DEFAULT_VOICE=nova

# Other AI Providers
AI_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT_SECONDS=12.0
AI_MAX_RETRIES=2
AI_ALLOW_OFFLINE_FALLBACK=true

# Google Calendar Integration & OAuth
CALENDAR_PROVIDER=google_calendar
GOOGLE_CLIENT_ID=placeholder-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
CALENDAR_ENCRYPTION_KEY=
CALENDAR_REQUEST_TIMEOUT_SECONDS=10.0

# Google Gmail Integration & OAuth
GMAIL_PROVIDER=google_gmail
GOOGLE_GMAIL_CLIENT_ID=placeholder-google-client-id.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=placeholder-google-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
GMAIL_REQUEST_TIMEOUT_SECONDS=10.0

# Persistent Notification Engine
NOTIFICATION_DISPATCH_SECRET=placeholder-dispatch-secret
NOTIFICATION_DEFAULT_LEAD_TIME_MINUTES=30
NOTIFICATION_MAX_RETRY_ATTEMPTS=3
NOTIFICATION_LEASE_DURATION_SECONDS=300
NOTIFICATION_BASE_BACKOFF_SECONDS=60
