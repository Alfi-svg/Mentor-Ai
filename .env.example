# ==============================================================================
# Mentor AI — Environment Configuration Template (.env.example)
# IMPORTANT: Never commit actual API keys or secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development                # "development" | "staging" | "production"
LOG_LEVEL=INFO                         # "DEBUG" | "INFO" | "WARNING" | "ERROR"
PORT=8000
HOST=0.0.0.0

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars

# Supabase (PostgreSQL & Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@your-project-id.supabase.co:5432/postgres

# AI Model Provider Configuration
# Supported providers: "gemini" (Free Tier) | "openai" | "offline"
AI_PROVIDER=gemini                    # Defaults to "gemini" with free-tier gemini-3.8-flash
GEMINI_API_KEY=                       # Google AI Studio API key (free tier)
GEMINI_MODEL=gemini-3.8-flash         # High speed, tool-calling free-tier model
OPENAI_API_KEY=                       # OpenAI API key (optional)

# Google Calendar Integration (Optional OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback

# MCP Server
MCP_TRANSPORT=stdio                    # "stdio" | "sse"
MCP_SERVER_PORT=8001
